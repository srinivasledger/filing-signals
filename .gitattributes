# Generated on every pipeline run, so a merge conflict here is never
# meaningful - both sides are machine output from the same inputs. Marking
# them binary stops git attempting a line merge and producing a conflict.
data/state/health.json    -merge -diff
data/state/pipeline.json  -merge -diff
data/state/history.json   -merge -diff

# Append-only event logs. A union merge keeps both sides' lines instead of
# writing conflict markers into the data - which happened, putting "<<<<<<<"
# into a JSONL file and publishing five duplicate entries. Union can duplicate
# rows, so the pipeline de-duplicates on load and on write.
data/events/*.jsonl       merge=union
